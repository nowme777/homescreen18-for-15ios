+BOOL Home18CanStyleView(UIView *view) {
+    if(g_home18Everywhere)return YES;
+    if(![[NSBundle.mainBundle bundleIdentifier] isEqualToString:@"com.apple.springboard"])return NO;
+    for(UIView *v=view;v;v=v.superview) {
+        if([v respondsToSelector:@selector(location)]) {
+            id location=[v performSelector:@selector(location)];
+            if([location isKindOfClass:NSString.class]) {
+                NSString *s=[location lowercaseString];
+                for(NSString *excluded in @[@"library",@"search",@"spotlight",@"switcher",@"notification"])if([s containsString:excluded])return NO;
+                for(NSString *included in @[@"root",@"dock",@"folder",@"home"])if([s containsString:included])return YES;
+            }
+        }
+        NSString *cls=NSStringFromClass(v.class);
+        if([cls containsString:@"RootFolder"]||[cls containsString:@"DockView"]||[cls containsString:@"FolderView"])return YES;
+    }
+    return NO;
+}
