+        self.creditDescription.font=[UIFont preferredFontForTextStyle:UIFontTextStyleSubheadline];
+        self.creditDescription.textColor=UIColor.secondaryLabelColor;
+        for(UILabel *label in @[self.creditName,self.creditDescription]) {
