+static NSString *Home18NormalizeSettingsAssetToken(NSString *value) {
+    if (![value isKindOfClass:NSString.class] || !value.length) return nil;
+    NSString *base = value.lastPathComponent.stringByDeletingPathExtension;
+    NSRange suffix = [base rangeOfString:@"@[23]x$" options:NSRegularExpressionSearch];
+    if (suffix.location != NSNotFound) base = [base substringToIndex:suffix.location];
+    NSMutableString *normalized = [NSMutableString string];
+    NSCharacterSet *allowed = NSCharacterSet.alphanumericCharacterSet;
+    NSString *lower = base.lowercaseString;
+    for (NSUInteger index = 0; index < lower.length; index++) {
+        unichar character = [lower characterAtIndex:index];
+        if ([allowed characterIsMember:character]) [normalized appendFormat:@"%C", character];
+    }
+    return normalized.length ? normalized : nil;
+}
