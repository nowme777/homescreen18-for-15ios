+@interface Home18WalletCell : PSTableCell
+@property(nonatomic,strong) UILabel *walletName;
+@property(nonatomic,strong) UILabel *walletAddress;
+@end
+@implementation Home18WalletCell
+- (instancetype)initWithStyle:(UITableViewCellStyle)style reuseIdentifier:(NSString *)identifier specifier:(PSSpecifier *)specifier {
+    if((self=[super initWithStyle:UITableViewCellStyleDefault reuseIdentifier:identifier specifier:specifier])) {
+        self.selectionStyle=UITableViewCellSelectionStyleDefault;
+        self.walletName=[UILabel new];self.walletAddress=[UILabel new];
+        self.walletName.font=[UIFont preferredFontForTextStyle:UIFontTextStyleBody];
+        self.walletName.textColor=Home18PreferencesAccentColor();
+        self.walletAddress.font=[UIFont monospacedSystemFontOfSize:13 weight:UIFontWeightRegular];
+        self.walletAddress.textColor=UIColor.secondaryLabelColor;
+        for(UILabel *label in @[self.walletName,self.walletAddress]) {
+            label.numberOfLines=0;label.lineBreakMode=NSLineBreakByCharWrapping;
+            label.adjustsFontForContentSizeCategory=YES;
+        }
+        UIStackView *stack=[[UIStackView alloc] initWithArrangedSubviews:@[self.walletName,self.walletAddress]];
+        stack.axis=UILayoutConstraintAxisVertical;stack.spacing=7;stack.translatesAutoresizingMaskIntoConstraints=NO;
+        [self.contentView addSubview:stack];
+        UIImageView *copyIcon=[[UIImageView alloc] initWithImage:[UIImage systemImageNamed:@"doc.on.doc"]];
+        copyIcon.tintColor=Home18PreferencesAccentColor();
+        self.accessoryView=copyIcon;
+        [NSLayoutConstraint activateConstraints:@[
+            [stack.leadingAnchor constraintEqualToAnchor:self.contentView.leadingAnchor constant:16],
+            [stack.trailingAnchor constraintEqualToAnchor:self.contentView.trailingAnchor constant:-12],
+            [stack.topAnchor constraintEqualToAnchor:self.contentView.topAnchor constant:13],
+            [stack.bottomAnchor constraintEqualToAnchor:self.contentView.bottomAnchor constant:-13]]];
+        [self home18UpdateWallet:specifier];
+    }
+    return self;
+}
+- (void)home18UpdateWallet:(PSSpecifier *)specifier {
+    self.walletName.text=specifier.name;
+    self.walletAddress.text=[specifier propertyForKey:@"copyValue"] ?: @"";
+}
+- (void)refreshCellContentsWithSpecifier:(PSSpecifier *)specifier {
+    [super refreshCellContentsWithSpecifier:specifier];[self home18UpdateWallet:specifier];
+}
+- (void)layoutSubviews {
+    [super layoutSubviews];self.textLabel.hidden=YES;self.detailTextLabel.hidden=YES;
+}
+@end
