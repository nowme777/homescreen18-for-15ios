+// One resolver for both the renderer and the menu previews. In this rootless
+// build the payload is installed under /var/jb, regardless of helper-library defaults.
+static inline NSString *Home18PackDirectory(void) {
+    NSString *relative = @"/Library/Application Support/26Home/IconPacks/Home18";
+    NSMutableArray<NSString *> *candidates = [NSMutableArray arrayWithObject:@"/var/jb/Library/Application Support/26Home/IconPacks/Home18"];
+    NSString *mapped=jbroot(relative);
+    if (mapped.length) [candidates addObject:mapped];
+    [candidates addObject:relative];
+    NSFileManager *files = NSFileManager.defaultManager;
+    for (NSString *candidate in candidates) {
+        if ([files isReadableFileAtPath:[candidate stringByAppendingPathComponent:@"Dark/com.apple.mobilephone.png"]]) return candidate;
+    }
+    return candidates.firstObject;
+}
