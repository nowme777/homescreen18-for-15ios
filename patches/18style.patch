+static NSString *Home18StringProperty(PSSpecifier *specifier, NSString *key) {
+    if (!specifier || !key.length) return nil;
+    id value = nil;
+    @try { value = [specifier propertyForKey:key]; } @catch (NSException *exception) {}
+    if ([value isKindOfClass:NSString.class]) return value;
+    if ([value isKindOfClass:NSURL.class]) return [(NSURL *)value path];
+    if ([value isKindOfClass:NSBundle.class]) {
+        NSBundle *bundle = value;
+        return bundle.bundleIdentifier ?: bundle.bundlePath.lastPathComponent.stringByDeletingPathExtension;
+    }
+    if ([value isKindOfClass:UIImage.class]) {
+        NSString *name = objc_getAssociatedObject(value, &kHome18SettingsAssetNameKey);
+        if (name.length) return name;
+    }
+    return nil;
+}
