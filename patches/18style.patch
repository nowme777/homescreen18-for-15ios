+@interface Home18SupportController : PSListController
+@end
+@implementation Home18SupportController
+- (void)viewDidLoad {[super viewDidLoad];self.title=@"Поддержать меня";Home18ApplyPurpleAppearance(self);}
+- (void)viewWillAppear:(BOOL)animated {[super viewWillAppear:animated];Home18ApplyPurpleAppearance(self);}
+- (NSArray *)specifiers {if(!_specifiers)_specifiers=[self loadSpecifiersFromPlistName:@"Support" target:self];return _specifiers;}
+- (CGFloat)tableView:(UITableView *)tableView heightForRowAtIndexPath:(NSIndexPath *)indexPath {return UITableViewAutomaticDimension;}
+- (CGFloat)tableView:(UITableView *)tableView estimatedHeightForRowAtIndexPath:(NSIndexPath *)indexPath {return 92.0;}
+- (void)tableView:(UITableView *)tableView willDisplayCell:(UITableViewCell *)cell forRowAtIndexPath:(NSIndexPath *)indexPath {
+    PSSpecifier *specifier=[cell respondsToSelector:@selector(specifier)] ? [(PSTableCell *)cell specifier] : nil;
+    Home18StylePreferenceCell(cell,specifier);
+}
+- (void)tableView:(UITableView *)tableView didSelectRowAtIndexPath:(NSIndexPath *)indexPath {
+    PSSpecifier *specifier=[self specifierAtIndexPath:indexPath];
+    NSString *address=[specifier propertyForKey:@"copyValue"];
+    if(address.length) {
+        UIPasteboard.generalPasteboard.string=address;
+        UINotificationFeedbackGenerator *feedback=[UINotificationFeedbackGenerator new];
+        [feedback notificationOccurred:UINotificationFeedbackTypeSuccess];
+        UIAlertController *alert=[UIAlertController alertControllerWithTitle:@"Скопировано"
+                                                                     message:specifier.name
+                                                              preferredStyle:UIAlertControllerStyleAlert];
+        [self presentViewController:alert animated:YES completion:nil];
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW,(int64_t)(0.75*NSEC_PER_SEC)),dispatch_get_main_queue(),^{
+            [alert dismissViewControllerAnimated:YES completion:nil];
+        });
+    }
+    [tableView deselectRowAtIndexPath:indexPath animated:YES];
+}
+@end
