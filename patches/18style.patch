--- a/Hooks/BadgesAndWidgets.x
+++ b/Hooks/BadgesAndWidgets.x
@@ -1,0 +2,110 @@
+#import "../Home18Pixels.h"
+
+static char kHome18SavedWidgetFiltersKey;
+static char kHome18WidgetRefreshPendingKey;
+
+// QuartzCore validates both the 20-float layout and the encoded struct name.
+// A differently named wrapper has the same bytes but is rejected by
+// CAFilter's inputColorMatrix KVC path on iOS 15.
+typedef struct CAColorMatrix {
+    float m11, m12, m13, m14, m15;
+    float m21, m22, m23, m24, m25;
+    float m31, m32, m33, m34, m35;
+    float m41, m42, m43, m44, m45;
+} CAColorMatrix;
+
+static BOOL Home18IsWidgetView(UIView *view) {
+    if (!view) return NO;
+    for (NSString *name in @[@"SBHShadowedWidgetView", @"SBHPortaledShadowedWidgetView",
+                             @"SBHWidgetWrapperView", @"SBHWidgetContainerView",
+                             @"SBHWidgetWrapperBackgroundView"]) {
+        Class cls=NSClassFromString(name);
+        if (cls && [view isKindOfClass:cls]) return YES;
+    }
+    return NO;
+}
+
+static UIView *Home18OutermostWidgetHost(UIView *view) {
+    UIView *root = view;
+    UIView *cursor = view.superview;
+    for (NSUInteger depth = 0; cursor && depth < 12; depth++, cursor = cursor.superview) {
+        if (Home18IsWidgetView(cursor)) root = cursor;
+    }
+    return root;
+}
+
+static UIColor *Home18AccentColor(void) {
+    UIColor *chosen=[[LGCustomIconGenerator2 sharedGenerator] adjustedTintColorFromHex:(g_tintColor ?: @"#00FFFF") isDarkTheme:YES];
+    CGFloat r=1.0,g=1.0,b=1.0,a=1.0;
+    if (![chosen getRed:&r green:&g blue:&b alpha:&a]) return chosen;
+    float rr=r,gg=g,bb=b;H18Color(&rr,&gg,&bb);
+    return [UIColor colorWithRed:rr green:gg blue:bb alpha:1.0];
+}
+
+static void Home18SetWidgetColorFilter(UIView *view, BOOL enabled, UIColor *accent) {
+    if (!view) return;
+    id saved=objc_getAssociatedObject(view,&kHome18SavedWidgetFiltersKey);
+    if (!enabled) {
+        if (saved) {
+            view.layer.filters=(saved==NSNull.null) ? nil : saved;
+            objc_setAssociatedObject(view,&kHome18SavedWidgetFiltersKey,nil,OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+        }
+        return;
+    }
+    if (!saved) {
+        objc_setAssociatedObject(view,&kHome18SavedWidgetFiltersKey,view.layer.filters ?: NSNull.null,OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+    }
+    CGFloat red=1.0,green=1.0,blue=1.0,alpha=1.0;
+    [accent getRed:&red green:&green blue:&blue alpha:&alpha];
