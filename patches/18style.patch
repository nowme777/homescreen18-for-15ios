+static NSArray<NSString *> *Home18PreferencePaths(void) {
+    NSMutableArray<NSString *> *paths = [NSMutableArray array];
+    NSString *homePath = [NSHomeDirectory() stringByAppendingPathComponent:@"Library/Preferences/local.icontint15.26base.plist"];
+    for (NSString *path in @[homePath,
+                             @"/var/mobile/Library/Preferences/local.icontint15.26base.plist",
+                             @"/var/jb/var/mobile/Library/Preferences/local.icontint15.26base.plist",
+                             @"/var/jb/Library/Preferences/local.icontint15.26base.plist"]) {
+        if (path.length && ![paths containsObject:path]) [paths addObject:path];
+    }
+    return paths;
+}
+
+NSDictionary *Home18LoadPersistentPreferences(void) {
+    NSFileManager *fm = NSFileManager.defaultManager;
+    NSDictionary *best = nil;
+    NSDate *bestDate = nil;
+    for (NSString *path in Home18PreferencePaths()) {
+        NSDictionary *candidate = [NSDictionary dictionaryWithContentsOfFile:path];
+        if (![candidate isKindOfClass:NSDictionary.class] || candidate.count == 0) continue;
+        NSDate *date = [[fm attributesOfItemAtPath:path error:nil] fileModificationDate] ?: NSDate.distantPast;
+        if (!best || [date compare:bestDate] == NSOrderedDescending) {
+            best = candidate;
+            bestDate = date;
+        }
+    }
+    return best ?: @{};
+}
+
+void Home18PersistPreferenceValues(NSDictionary *values) {
+    if (![values isKindOfClass:NSDictionary.class] || values.count == 0) return;
+
+    NSMutableDictionary *merged = [Home18LoadPersistentPreferences() mutableCopy] ?: [NSMutableDictionary dictionary];
+    [values enumerateKeysAndObjectsUsingBlock:^(id key, id value, BOOL *stop) {
+        if (key && value) merged[key] = value;
+    }];
+
+    // /var/mobile is the stable preference location shared by SpringBoard,
+    // Preferences and the rootless preference bundle on Dopamine.
+    NSString *primary = @"/var/mobile/Library/Preferences/local.icontint15.26base.plist";
+    NSString *homePath = [NSHomeDirectory() stringByAppendingPathComponent:@"Library/Preferences/local.icontint15.26base.plist"];
+    NSMutableArray<NSString *> *writePaths = [NSMutableArray arrayWithObject:primary];
+    if (homePath.length && ![writePaths containsObject:homePath]) [writePaths addObject:homePath];
+    for (NSString *path in writePaths) {
+        NSString *directory = path.stringByDeletingLastPathComponent;
+        if ([NSFileManager.defaultManager isWritableFileAtPath:directory]) {
+            [merged writeToFile:path atomically:YES];
+        }
+    }
+
+    [values enumerateKeysAndObjectsUsingBlock:^(id key, id value, BOOL *stop) {
+        if ([key isKindOfClass:NSString.class]) {
+            CFPreferencesSetAppValue((__bridge CFStringRef)key,
+                                     (__bridge CFPropertyListRef)value,
+                                     CFSTR("local.icontint15.26base"));
+        }
+    }];
+    CFPreferencesAppSynchronize(CFSTR("local.icontint15.26base"));
+    g_home18PersistentPreferences = [merged copy];
+}
+
+static id Home18PreferenceObject(NSString *key, NSUserDefaults *fallback) {
+    if (!key) return nil;
+    id diskValue = g_home18PersistentPreferences[key];
