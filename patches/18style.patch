+// The switcher header uses image containers instead of SBIconImageView.
+static char H18HeaderOriginalKey, H18HeaderRenderedKey, H18HeaderStyleKey;
+static void H18RefreshSwitcherHeader(UIView *header) {
+    Ivar ivar=class_getInstanceVariable([header class], "_itemsToIconImageViews");
+    if (!ivar) return;
+    id mapping=object_getIvar(header,ivar);
+    if (![mapping isKindOfClass:NSDictionary.class]) return;
+    NSString *stamp=[NSString stringWithFormat:@"%@/%@/%@/%@",g_iconStyle,g_tintColor,g_themeMode,g_darkIconMode];
+    for (id item in [mapping allKeys]) {
+        id display=item;
+        if (![display respondsToSelector:@selector(bundleIdentifier)] && [display respondsToSelector:@selector(displayItem)]) display=[display performSelector:@selector(displayItem)];
+        if (![display respondsToSelector:@selector(bundleIdentifier)]) continue;
+        NSString *bundle=[display performSelector:@selector(bundleIdentifier)];
+        id container=mapping[item];
+        if (![bundle isKindOfClass:NSString.class] || isAppExcluded(bundle) || ![container respondsToSelector:@selector(image)] || ![container respondsToSelector:@selector(setImage:)]) continue;
+        UIImage *image=[container performSelector:@selector(image)];
+        if (![image isKindOfClass:UIImage.class]) continue;
+        UIImage *previous=objc_getAssociatedObject(container,&H18HeaderRenderedKey);
+        if (image==previous && [stamp isEqual:objc_getAssociatedObject(container,&H18HeaderStyleKey)]) continue;
+        UIImage *original=image==previous ? objc_getAssociatedObject(container,&H18HeaderOriginalKey) : image;
+        UIImage *styled=Home26RequestStyledIcon(original,bundle);
+        if (!styled) continue;
+        UIGraphicsBeginImageContextWithOptions(original.size,NO,original.scale);
+        [styled drawInRect:(CGRect){CGPointZero,original.size}];
+        UIImage *resized=UIGraphicsGetImageFromCurrentImageContext();
+        UIGraphicsEndImageContext();
+        if (!resized) continue;
+        objc_setAssociatedObject(container,&H18HeaderOriginalKey,original,OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+        objc_setAssociatedObject(container,&H18HeaderRenderedKey,resized,OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+        objc_setAssociatedObject(container,&H18HeaderStyleKey,stamp,OBJC_ASSOCIATION_COPY_NONATOMIC);
+        [container performSelector:@selector(setImage:) withObject:resized];
+    }
+}
+%hook SBFluidSwitcherItemContainerHeaderView
+- (void)layoutSubviews {
+    %orig;
+    H18RefreshSwitcherHeader((UIView *)self);
+}
+%end
