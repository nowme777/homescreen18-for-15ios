diff --git a/scripts/import_home18_icons.py b/scripts/import_home18_icons.py
new file mode 100644
index 0000000..f615e6c
--- /dev/null
+++ b/scripts/import_home18_icons.py
@@ -0,0 +1,41 @@
+"""Import only PNG artwork from a user-supplied Homescreen18 deb; never run its code."""
+from pathlib import Path
+import subprocess,tarfile,hashlib,re,json,shutil,struct,sys
+root=Path(__file__).resolve().parents[1]
+if len(sys.argv)!=2:raise SystemExit('Usage: python3 scripts/import_home18_icons.py /path/to/Homescreen18.deb')
+source=Path(sys.argv[1])
+prefix='var/jb/Library/Application Support/homescreen18/IconBundles/'
+pack=root/'layout/Library/Application Support/26Home/IconPacks/Home18'
+(pack/'Dark').mkdir(parents=True,exist_ok=True);(pack/'Light').mkdir(exist_ok=True)
+index={};manifest=[]
+process=subprocess.Popen(['dpkg-deb','--fsys-tarfile',str(source)],stdout=subprocess.PIPE)
+with tarfile.open(fileobj=process.stdout,mode='r|') as archive:
+ for member in archive:
+  name=member.name.removeprefix('./')
+  if not member.isfile() or not name.startswith(prefix) or not name.lower().endswith('.png'):continue
+  filename=name[len(prefix):]
+  if '/' in filename or filename in {'.','..'}:raise ValueError('Unexpected path')
+  data=archive.extractfile(member).read()
+  if data[:8]!=b'\x89PNG\r\n\x1a\n':raise ValueError('Unexpected image bytes')
+  width,height=struct.unpack('>II',data[16:24])
+  if not (0<width<=1024 and 0<height<=1024):raise ValueError('Unexpected dimensions')
+  bundle=filename[:-4].removesuffix('-large')
+  if bundle=='ClockIconBackgroundSquare':bundle='com.apple.mobiletimer'
+  if re.match(r'^[A-Za-z0-9]{10}\.',bundle):bundle=bundle[11:]
+  bundle=bundle.lower()
+  if bundle in index:raise ValueError('Duplicate normalized bundle ID: '+bundle)
+  index[bundle]=filename
+  (pack/'Dark'/filename).write_bytes(data)
+  manifest.append({'bundle_id':bundle,'filename':filename,'width':width,'height':height,'sha256':hashlib.sha256(data).hexdigest()})
+if process.wait()!=0:raise RuntimeError('Debian archive read failed')
+# Keep dynamic calendar/clock templates; upstream draws live content on top.
+upstream=root/'layout/Library/Application Support/26Home/SolidGlass'
+for theme in ['Light','Dark']:
+ for filename in ['com.apple.mobilecal-large.png','ClockIconBackgroundSquare-large.png']:
+  shutil.copy2(upstream/theme/filename,pack/theme/filename)
+shutil.copy2(upstream/'Light/com.apple.weather-large.png',pack/'Light/com.apple.weather-large.png')
