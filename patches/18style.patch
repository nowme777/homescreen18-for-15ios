+    CFPropertyListRef value = CFPreferencesCopyAppValue((__bridge CFStringRef)key,
+                                                        CFSTR("local.icontint15.26base"));
+    if (value) return CFBridgingRelease(value);
+    return [fallback objectForKey:key];
+}
