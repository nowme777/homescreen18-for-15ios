+static UIImage *Home18StyleLibraryCacheImage(UIImage *original, id icon) {
+    if (!original || !icon || !g_tweakEnabled || !g_home18Everywhere || Home26IsCoverSheetActive()) return original;
+    if (![icon respondsToSelector:@selector(applicationBundleID)]) return original;
+    NSString *bundleID=[icon performSelector:@selector(applicationBundleID)];
+    if (![bundleID isKindOfClass:NSString.class] || bundleID.length==0 || isAppExcluded(bundleID)) return original;
+    Home26SaveOriginalIcon(original,bundleID);
+    UIImage *styled=Home26FastCachedIcon(bundleID);
+    if (styled) return styled;
+    styled=Home26RequestStyledIcon(original,bundleID);
+    return styled ?: original;
+}
+
+static UIImage *Home18StyleFolderGridCellImage(UIImage *original, id icon) {
+    if (!original || !icon || !g_tweakEnabled || Home26IsCoverSheetActive()) return original;
+    if (!g_home18Everywhere && !g_home18RenderDepth) return original;
+    if (![icon respondsToSelector:@selector(applicationBundleID)]) return original;
+    NSString *bundleID = [icon performSelector:@selector(applicationBundleID)];
+    if (![bundleID isKindOfClass:NSString.class] || bundleID.length == 0 || isAppExcluded(bundleID)) return original;
+
+    UIImage *source = Home26OriginalIconForBundleID(bundleID) ?: original;
+    if (original.size.width >= 50.0 && original.size.height >= 50.0) {
+        Home26SaveOriginalIcon(original, bundleID);
+        source = original;
+    }
+    UIImage *styled = Home26FastCachedIcon(bundleID);
+    if (!styled) styled = Home26RequestStyledIcon(source, bundleID);
+    if (!styled) return original;
+
+    if (!CGSizeEqualToSize(styled.size, original.size) && original.size.width > 0.0 && original.size.height > 0.0) {
+        UIGraphicsBeginImageContextWithOptions(original.size, NO, original.scale > 0.0 ? original.scale : UIScreen.mainScreen.scale);
+        [styled drawInRect:(CGRect){CGPointZero, original.size}];
+        UIImage *resized = UIGraphicsGetImageFromCurrentImageContext();
+        UIGraphicsEndImageContext();
+        if (resized) styled = resized;
+    }
+    return styled;
+}
+
+static UIImage *Home18StyleFolderGridRawImage(UIImage *original) {
+    if (!original || !g_tweakEnabled || Home26IsCoverSheetActive()) return original;
+    if (!g_home18Everywhere && !g_home18RenderDepth) return original;
+
+    LGCustomIconGenerator2 *generator = [LGCustomIconGenerator2 sharedGenerator];
+    NSString *style = @"Default";
+    BOOL dark = NO;
+    [generator _resolveEffectiveStyle:&style isDarkTheme:&dark];
+
+    UIImage *styled = original;
+    if ([style isEqualToString:@"Tinted"]) {
+        UIImage *prepared = [generator generateDarkIconForImage:original bundleID:nil] ?: original;
+        UIColor *color = [generator adjustedTintColorFromHex:(g_tintColor ?: @"#9999FF") isDarkTheme:YES];
+        styled = [generator home18TintedImage:prepared color:color];
+    } else if ([style isEqualToString:@"Dark"] || dark) {
+        styled = [generator generateDarkIconForImage:original bundleID:nil] ?: original;
+    } else if ([style isEqualToString:@"Clear"]) {
+        styled = [generator generateClearIconForImage:original bundleID:nil] ?: original;
+    }
+    return styled ?: original;
+}
