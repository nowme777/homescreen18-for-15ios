@@ -0,0 +1,32 @@
+#include "../Home18Pixels.h"
+#include <assert.h>
+#include <stdio.h>
+#include <stdint.h>
+
+int main(void) {
+    for (int c=0;c<=90;c++) {
+        unsigned char p[4]={(unsigned char)c,(unsigned char)c,(unsigned char)c,255};
+        H18TintRGBA(p,1,1,4,.6f,.4f,.9f);
+        assert(p[0]==c && p[1]==c && p[2]==c && p[3]==255);
+    }
+    unsigned char white[4]={255,255,255,255};
+    H18TintRGBA(white,1,1,4,.6f,.4f,.9f);
+    assert(white[0]>white[1] && white[2]>white[0] && white[2]<230 && white[3]==255);
+    unsigned char red[4]={255,255,255,255};
+    H18TintRGBA(red,1,1,4,1,0,0);
+    assert(red[0]>=170 && red[0]<=175 && red[1]>=64 && red[1]<=68 && red[1]==red[2]);
+    uint32_t state=1234567;
+    for (int i=0;i<100000;i++) {
+        state=state*1664525U+1013904223U;
+        unsigned char alpha=state>>24;
+        unsigned char p[4]={(unsigned char)((state&255)*alpha/255),
+                           (unsigned char)(((state>>8)&255)*alpha/255),
+                           (unsigned char)(((state>>16)&255)*alpha/255),alpha};
+        H18TintRGBA(p,1,1,4,.6f,.4f,.9f);
+        assert(p[3]==alpha && p[0]<=alpha && p[1]<=alpha && p[2]<=alpha);
+    }
+    unsigned char transparent[4]={77,88,99,0};
+    H18TintRGBA(transparent,1,1,4,1,0,0);
+    assert(!transparent[0] && !transparent[1] && !transparent[2] && !transparent[3]);
+    puts("PASS: neutral dark backgrounds unchanged; white foreground follows chosen tint; 100000 premultiplied-alpha cases passed.");
+}
