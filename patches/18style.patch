+++ b/Home18Pixels.h
@@ -0,0 +1,49 @@
+#pragma once
+#include <math.h>
+#include <stddef.h>
+
+// Shared by the iOS bitmap renderer and native host tests. RGBA is premultiplied.
+static inline float H18Unit(float x) {
+    return isfinite(x) ? fminf(1.f, fmaxf(0.f, x)) : 0.f;
+}
+static inline float H18Smooth(float low, float high, float x) {
+    float t = H18Unit((x-low)/(high-low));
+    return t*t*(3.f-2.f*t);
+}
+// Endpoint mapping inferred from the supplied iOS 18 reference; not Apple's private transform.
+static inline void H18Color(float *r, float *g, float *b) {
+    float hi=fmaxf(*r,fmaxf(*g,*b)),lo=fminf(*r,fminf(*g,*b));
+    if (hi<=0) return;
+    float saturation=(hi-lo)/hi;
+    float value=hi*(1.f-.32f*saturation);
+    float floor=value*(1.f-.62f*saturation);
+    float scale=(value-floor)/fmaxf(hi-lo,.000001f);
+    *r=floor+(*r-lo)*scale; *g=floor+(*g-lo)*scale; *b=floor+(*b-lo)*scale;
+}
+static inline void H18TintRGBA(unsigned char *pixels, size_t width, size_t height,
+                              size_t stride, float red, float green, float blue) {
+    red=H18Unit(red); green=H18Unit(green); blue=H18Unit(blue);
+    H18Color(&red,&green,&blue);
+    for (size_t y=0; y<height; y++) {
+        for (size_t x=0; x<width; x++) {
+            unsigned char *p=pixels+y*stride+x*4;
+            if (!p[3]) { p[0]=p[1]=p[2]=0; continue; }
+            float alpha=p[3]/255.f;
+            float r=H18Unit(p[0]/(255.f*alpha));
+            float g=H18Unit(p[1]/(255.f*alpha));
+            float b=H18Unit(p[2]/(255.f*alpha));
+            float maximum=fmaxf(r,fmaxf(g,b)), minimum=fminf(r,fminf(g,b));
+            float luminance=.2126f*r+.7152f*g+.0722f*b;
+            // Preserve neutral dark artwork as the backdrop; color the bright
+            // or chromatic foreground directly, without cutting out the glyph.
+            float foreground=fmaxf(H18Smooth(.03f,.15f,maximum-minimum),
+                                    H18Smooth(.36f,.62f,maximum));
+            float detail=.22f+.78f*powf(luminance,.65f);
+            float neutral=luminance*(1.f-foreground);
+            float amount=detail*foreground;
+            p[0]=(unsigned char)(H18Unit(neutral+red*amount)*alpha*255.f+.5f);
+            p[1]=(unsigned char)(H18Unit(neutral+green*amount)*alpha*255.f+.5f);
+            p[2]=(unsigned char)(H18Unit(neutral+blue*amount)*alpha*255.f+.5f);
+        }
+    }
+}
