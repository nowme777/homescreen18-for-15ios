+static UIImage *Home18LoadSettingsAsset(PSSpecifier *specifier, UIImage *incoming, NSString **assetIdentity) {
+    UIImage *original = objc_getAssociatedObject(incoming, &kHome18OriginalSettingsIconKey) ?: incoming;
+    NSMutableArray<NSString *> *names = [NSMutableArray array];
+    NSMutableArray<NSString *> *bundles = [NSMutableArray array];
+
+    NSString *graphicIdentifier = Home18StringProperty(specifier, @"graphicIconIdentifier");
+    if (!graphicIdentifier.length) graphicIdentifier = Home18StringProperty(specifier, @"iconUTTypeIdentifier");
+    if ([graphicIdentifier containsString:@"graphic-icon"]) {
+        NSString *mappedName = Home18SettingsAssetNameForGraphicIdentifier(graphicIdentifier);
+        if (mappedName.length) [names addObject:mappedName];
+        [bundles addObject:@"com.apple.preferences-framework"];
+    }
+
+    NSString *associatedName = objc_getAssociatedObject(original, &kHome18SettingsAssetNameKey);
+    NSString *associatedBundle = objc_getAssociatedObject(original, &kHome18SettingsAssetBundleKey);
+    NSString *associatedPath = objc_getAssociatedObject(original, &kHome18SettingsAssetPathKey);
+    for (NSString *candidate in @[associatedName ?: @"", associatedPath ?: @""]) {
+        if (candidate.length && ![names containsObject:candidate]) [names addObject:candidate];
+    }
+    if (associatedBundle.length) [bundles addObject:associatedBundle];
+
+    for (NSString *key in @[@"iconName", @"icon", @"iconImage", @"iconPath", @"iconURL", @"imageName"]) {
+        NSString *candidate = Home18StringProperty(specifier, key);
+        if (candidate.length && ![names containsObject:candidate]) [names addObject:candidate];
+    }
+    for (NSString *key in @[@"iconBundleIdentifier", @"bundleIdentifier", @"bundleID", @"bundle", @"iconBundle"]) {
+        NSString *candidate = Home18StringProperty(specifier, key);
+        if (candidate.length && ![bundles containsObject:candidate]) [bundles addObject:candidate];
+    }
+
+    NSString *identifier = specifier.identifier;
+    if (identifier.length && ![identifier containsString:@"."]) {
+        NSString *alias = Home18SettingsAssetAlias(identifier);
+        if (alias.length) [names addObject:alias];
+        [names addObject:identifier];
+    }
+    if (specifier.name.length) {
+        NSString *alias = Home18SettingsAssetAlias(specifier.name);
+        if (alias.length) [names addObject:alias];
+        [names addObject:specifier.name];
+    }
+
+    NSInteger requestedScale = UIScreen.mainScreen.scale >= 2.5 ? 3 : 2;
+    NSDictionary<NSString *, NSString *> *index = Home18SettingsAssetIndex();
+    for (NSString *name in names) {
+        NSString *token = Home18NormalizeSettingsAssetToken(name);
+        if (!token.length) continue;
+        NSMutableArray<NSString *> *lookupBundles = [NSMutableArray arrayWithArray:bundles];
+        [lookupBundles addObject:@"com.apple.preferences-framework"];
+        [lookupBundles addObject:@"com.apple.preferences"];
+        for (NSString *bundle in lookupBundles) {
+            NSString *bundleToken = bundle.lowercaseString.lastPathComponent.stringByDeletingPathExtension;
+            for (NSNumber *scale in @[@(requestedScale), @(requestedScale == 3 ? 2 : 3)]) {
+                NSString *key = [NSString stringWithFormat:@"%@|%@|%@", bundleToken, token, scale];
+                NSString *path = index[key];
+                if (!path.length) continue;
+                UIImage *loaded = [UIImage imageWithContentsOfFile:path];
+                if (loaded.CGImage && loaded.scale != scale.doubleValue) {
+                    loaded = [UIImage imageWithCGImage:loaded.CGImage scale:scale.doubleValue orientation:loaded.imageOrientation];
+                }
+                if (loaded) {
+                    if (assetIdentity) *assetIdentity = [NSString stringWithFormat:@"%@/%@", bundleToken, token];
+                    return loaded;
+                }
+            }
+        }
+
+        // A global fallback handles third-party preference bundles whose image
+        // name is known but whose NSBundle metadata was lost by a cache layer.
+        if (token.length <= 3 || [@[@"icon", @"appicon", @"iconsmall"] containsObject:token]) continue;
+        for (NSNumber *scale in @[@(requestedScale), @(requestedScale == 3 ? 2 : 3)]) {
+            NSString *path = index[[NSString stringWithFormat:@"*|%@|%@", token, scale]];
+            if (!path.length) continue;
+            UIImage *loaded = [UIImage imageWithContentsOfFile:path];
+            if (loaded.CGImage && loaded.scale != scale.doubleValue) {
+                loaded = [UIImage imageWithCGImage:loaded.CGImage scale:scale.doubleValue orientation:loaded.imageOrientation];
+            }
+            if (loaded) {
+                if (assetIdentity) *assetIdentity = token;
+                return loaded;
+            }
+        }
+    }
+    return nil;
+}
