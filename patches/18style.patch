+#pragma once
+#include <math.h>
+#include <stddef.h>
+// Independent implementation of the measured Homescreen18 rendering equations.
+// Evidence and method addresses: home18-analysis/RENDERING.md.
+static inline float H18Unit(float x) { return isfinite(x)?fminf(1,fmaxf(0,x)):0; }
+static inline float H18Smooth(float a,float b,float x) {float t=H18Unit((x-a)/(b-a));return t*t*(3-2*t);}
+// Colors are now resolved by the panel's original two-stage HSV control.
+static inline void H18Color(float *r,float *g,float *b) {*r=H18Unit(*r);*g=H18Unit(*g);*b=H18Unit(*b);}
+static inline void H18TintRGB(float r,float g,float b,float cr,float cg,float cb,int prepared,float *out) {
+ float luma=fmaf(b,.0722f,fmaf(r,.2126f,g*.7152f));
+ float hi=fmaxf(cr,fmaxf(cg,cb)),lo=fminf(cr,fminf(cg,cb));
+ float sat=hi>0?(hi-lo)/hi:0;
+ float value=H18Unit(fmaxf(hi,.55f)*fminf(1,fmaxf(.12f,fmaf(luma,.78f,.22f))));
+ float ratio=hi>0?value/hi:0;
+ out[0]=sat<.05f?value:cr*ratio;out[1]=sat<.05f?value:cg*ratio;out[2]=sat<.05f?value:cb*ratio;
+ if (prepared) {
+  float mx=fmaxf(r,fmaxf(g,b)),mn=fminf(r,fminf(g,b));
+  float s=mx>0?(mx-mn)/mx:0;
+  float preserve=(1-H18Smooth(.26f,.38f,luma))*(1-H18Smooth(.20f,.34f,s));
+  if(preserve>.001f) {out[0]=fmaf(r-out[0],preserve,out[0]);out[1]=fmaf(g-out[1],preserve,out[1]);out[2]=fmaf(b-out[2],preserve,out[2]);}
+ }
+}
+static inline void H18TintRGBAMode(unsigned char *pixels,size_t width,size_t height,size_t stride,float red,float green,float blue,int prepared) {
+ for(size_t y=0;y<height;y++)for(size_t x=0;x<width;x++) {
+  unsigned char *p=pixels+y*stride+x*4;
+  if(p[3]<=4){p[0]=p[1]=p[2]=p[3]=0;continue;}
+  float alpha=p[3]/255.f,r=H18Unit(p[0]/(255.f*alpha)),g=H18Unit(p[1]/(255.f*alpha)),b=H18Unit(p[2]/(255.f*alpha)),o[3];
+  H18TintRGB(r,g,b,red,green,blue,prepared && alpha>=.08f,o);
+  float hi=fmaxf(red,fmaxf(green,blue)),lo=fminf(red,fminf(green,blue));
+  float outputAlpha=(hi>0 && (hi-lo)/hi>=.05f)?1:alpha;
+  for(int k=0;k<3;k++)p[k]=(unsigned char)(H18Unit(o[k])*outputAlpha*255.f+.5f);
+  p[3]=(unsigned char)(outputAlpha*255.f+.5f);
+ }
+}
+static inline void H18TintRGBA(unsigned char *p,size_t w,size_t h,size_t stride,float r,float g,float b) {H18TintRGBAMode(p,w,h,stride,r,g,b,1);}
