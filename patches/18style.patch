+    [color getRed:&r green:&g blue:&b alpha:&a];
+    H18TintRGBAMode(pixels,width,height,stride,r,g,b,prepared);
+    CGImageRef result=CGBitmapContextCreateImage(context);
+    UIImage *output=result ? [UIImage imageWithCGImage:result scale:1 orientation:image.imageOrientation] : image;
+    if (result) CGImageRelease(result);
+    CGContextRelease(context); free(pixels);
+    return output;
+}
