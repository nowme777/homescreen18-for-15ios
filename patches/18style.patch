+static NSArray<NSString *> *Home18SettingsIconRoots(void) {
+    static NSArray<NSString *> *roots = nil;
+    static dispatch_once_t onceToken;
+    dispatch_once(&onceToken, ^{
+        NSString *relative = @"/Library/Application Support/26Home/SettingsIcons";
+        NSMutableArray<NSString *> *values = [NSMutableArray arrayWithObject:@"/var/jb/Library/Application Support/26Home/SettingsIcons"];
+        NSString *mapped = jbroot(relative);
+        if (mapped.length && ![values containsObject:mapped]) [values addObject:mapped];
+        if (![values containsObject:relative]) [values addObject:relative];
+        roots = [values copy];
+    });
+    return roots;
+}
+
+static NSDictionary<NSString *, NSString *> *Home18SettingsAssetIndex(void) {
+    static NSDictionary<NSString *, NSString *> *index = nil;
+    static dispatch_once_t onceToken;
+    dispatch_once(&onceToken, ^{
+        NSMutableDictionary<NSString *, NSString *> *result = [NSMutableDictionary dictionary];
+        NSFileManager *files = NSFileManager.defaultManager;
+        NSString *root = nil;
+        for (NSString *candidate in Home18SettingsIconRoots()) {
+            BOOL isDirectory = NO;
+            if ([files fileExistsAtPath:candidate isDirectory:&isDirectory] && isDirectory) {
+                root = candidate;
+                break;
+            }
+        }
+        if (!root.length) {
+            index = @{};
+            return;
+        }
+
+        NSDirectoryEnumerator *enumerator = [files enumeratorAtPath:root];
+        for (NSString *relativePath in enumerator) {
+            if (![relativePath.pathExtension.lowercaseString isEqualToString:@"png"]) continue;
+            NSArray<NSString *> *components = relativePath.pathComponents;
+            NSUInteger bundlesIndex = [components indexOfObject:@"Bundles"];
+            if (bundlesIndex == NSNotFound || bundlesIndex + 2 >= components.count) continue;
+            NSString *bundleID = components[bundlesIndex + 1].lowercaseString;
+            NSString *filename = relativePath.lastPathComponent;
+            NSString *token = Home18NormalizeSettingsAssetToken(filename);
+            if (!token.length) continue;
+            NSInteger scale = [filename.lowercaseString containsString:@"@3x"] ? 3 : 2;
+            NSString *fullPath = [root stringByAppendingPathComponent:relativePath];
+            result[[NSString stringWithFormat:@"%@|%@|%ld", bundleID, token, (long)scale]] = fullPath;
+
+            NSString *genericKey = [NSString stringWithFormat:@"*|%@|%ld", token, (long)scale];
+            BOOL preferredBundle = [bundleID isEqualToString:@"com.apple.preferences-framework"] ||
+                                   [bundleID isEqualToString:@"com.apple.preferences"];
+            if (!result[genericKey] || preferredBundle) result[genericKey] = fullPath;
+        }
+        index = [result copy];
+    });
+    return index;
+}
